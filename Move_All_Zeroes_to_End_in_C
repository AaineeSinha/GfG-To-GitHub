class Solution {
public:
    void pushZerosToEnd(vector<int>& arr) {
        int n = arr.size();
        int j = 0;

        // Move all non-zero elements to the beginning
        for (int i = 0; i < n; i++) {
            if (arr[i] != 0) {
                arr[j++] = arr[i];
            }
        }

        // Fill the rest with 0s
        while (j < n) {
            arr[j++] = 0;
        }
    }
};
